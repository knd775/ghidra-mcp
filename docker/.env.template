# Docker Compose env for docker/docker-compose.yml
#
#   cp docker/.env.template docker/.env
#   docker compose --env-file docker/.env -f docker/docker-compose.yml up -d
#
# Or: cd docker && docker compose up -d
# (Compose loads .env from the working directory / project directory.)
#
# docker/.env is gitignored. Do not commit secrets.

# GHCR image owner and tag. ghcr.yml publishes headless, bridge,
# builder, and bsim (postgres + lshvector) to
# ghcr.io/<owner>/ghidra-mcp-{headless,bridge,builder,bsim}:<tag>
# on push to main/dev/develop. First GHCR package for a new image is
# created on that push; set it public if the others are.
GHCR_OWNER=knd775
GHIDRA_MCP_VERSION=dev

# Must match the Ghidra build inside ghidra-mcp-headless (12.1.2 on this fork).
GHIDRA_VERSION=12.1.2

# Address Ghidra Server advertises for RMI, and the host IP the ports bind.
# VPN/LAN address, not 0.0.0.0. Clients must be able to dial this exact IP.
BIND_ADDR=

# Hostname on the ghidra-server container (TLS SAN / public name).
GHIDRA_PUBLIC_HOSTNAME=

# Space-separated Ghidra Server accounts (blacktop/ghidra). Initial password
# is typically changeme and must be changed on first login.
GHIDRA_USERS=

# Ghidra Server login used by the headless process. GHIDRA_USER is set to
# this same value (-Duser.name). They must match.
GHIDRA_SERVER_USER=
GHIDRA_SERVER_PASSWORD=

# openssl rand -hex 32
# Required: the headless server binds 0.0.0.0 and will not start without it.
GHIDRA_MCP_AUTH_TOKEN=

# Absolute host path mounted at /data (GHIDRA_MCP_FILE_ROOT). Relative paths
# do not resolve usefully in a Portainer stack. Must be writable by uid 1000
# so ghidra-mcp and the builder can share /data/uploads.
SAMPLES_DIR=

# Tunnel hostname(s) for the bridge Host allow-list, comma-separated.
# Required or Cloudflare-forwarded Host headers are rejected.
GHIDRA_MCP_ALLOWED_HOSTS=

# Dashboard-managed Cloudflare Tunnel token. The tunnel is not auth.
TUNNEL_TOKEN=

# Executes Java in the Ghidra process. The live stack sets this to 1.
GHIDRA_MCP_ALLOW_SCRIPTS=

# Optional overrides
# JAVA_OPTS=-Xmx8g -XX:+UseG1GC
# GHIDRA_MCP_MAX_CONCURRENT_REQUESTS=4
#
# BSim PostgreSQL (ghidra-bsim / ghidra-mcp-bsim). Not Ghidra Server credentials. openssl rand -hex 24
# Two databases on this one instance: embedded (medium_nosize, ARM) and
# userland (medium_nosize, x86-64). Corpus domains, not a pointer-size
# split. Published on BIND_ADDR:5432, never the tunnel.
BSIM_DB_USER=bsim
BSIM_DB_PASSWORD=
# BSIM_BACKUP_KEEP_DAYS=14
#
# file: leftovers / template sidecars still live on the ghidra-bsim volume
# at /srv/ghidra/bsim (GHIDRA_MCP_BSIM_ROOT). That path is not under
# GHIDRA_MCP_FILE_ROOT / /data.
#
# Reference builder: ghcr.io/<owner>/ghidra-mcp-builder:<tag>, always-on
# as compose service ghidra-builder. No host ports, no docker.sock.
# build_reference POSTs jobs on the compose network. The corpus
# definition is docker/references.yaml, bind-mounted at
# /data/references.yaml. x86-64 userland is docker/references.userland.yaml
# at /data/references.userland.yaml. Framework stubs: docker/stubs/
# (pico-sdk, musl, glibc, openssl, libsodium, sqlite). mode=framework
# harvests build-tree objects, never the linked ELF.
# Portainer pulls the image with the rest of the stack; corpus rebuilds
# are MCP tool calls.
