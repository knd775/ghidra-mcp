{
  "name": "pico-sdk",
  "generator": "cmake",
  "sdk_cache_var": "GHIDRA_SDK_PATH",
  "board_cache_var": "GHIDRA_BOARD",
  "libraries_cache_var": "GHIDRA_LIBRARIES",
  "toolchain_cache_vars": {
    "PICO_TOOLCHAIN_PATH": "{toolchain_bin}",
    "PICO_GCC_TRIPLE": "{toolchain_triple}"
  },
  "require_compile_flags": ["-mthumb"],
  "require_compile_flag_prefixes": ["-mcpu="]
}
